---
import { NAV_LINKS, SITE } from "../config";
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 border-b border-[var(--border)] bg-[var(--bg)]/80 backdrop-blur-md"
>
  <div class="container">
    <nav
      class="flex items-center justify-between h-16"
      aria-label="Navegação principal"
    >
      <!-- Logo -->
      <a
        href="/"
        class="font-semibold text-[var(--text)] hover:opacity-70 transition-opacity"
        aria-label={`${SITE.fullName} — página inicial`}
      >
        <span class="font-mono text-sm text-[var(--text-muted)]\">~/</span><span
          >davi</span
        >
      </a>

      <!-- Desktop nav links -->
      <ul class="hidden md:flex items-center gap-7" role="list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Right side: currículo + theme toggle + hamburger -->
      <div class="flex items-center gap-3">
        <!-- Botão currículo (desktop) -->
        <a
          href="/Curriculo_Davi_Guimaraes.pdf"
          download
          class="hidden md:inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--text)] transition-colors"
          aria-label="Baixar currículo em PDF"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Currículo
        </a>

        <ThemeToggle />

        <!-- Hamburger (mobile only) -->
        <button
          id="menu-toggle"
          class="md:hidden flex flex-col gap-1.5 p-2 rounded-md hover:bg-[var(--bg-subtle)] transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menu de navegação"
          data-menu-open="false"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[var(--border)] bg-[var(--bg)]"
    aria-hidden="true"
  >
    <ul class="container py-4 flex flex-col gap-1" role="list">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="block py-2.5 px-3 rounded-md text-sm text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <!-- Currículo no menu mobile -->
      <li class="mt-1 pt-3 border-t border-[var(--border)]">
        <a
          href="/Curriculo_Davi_Guimaraes.pdf"
          download
          class="flex items-center gap-2 py-2.5 px-3 rounded-md text-sm text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Baixar currículo
        </a>
      </li>
    </ul>
  </div>
</header>

<div class="h-16" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("data-menu-open") === "true";
      const next = !isOpen;
      toggle.setAttribute("data-menu-open", String(next));
      toggle.setAttribute("aria-expanded", String(next));
      menu.setAttribute("aria-hidden", String(!next));
      menu.classList.toggle("hidden", !next);
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute("data-menu-open", "false");
        toggle.setAttribute("aria-expanded", "false");
        menu.setAttribute("aria-hidden", "true");
        menu.classList.add("hidden");
      });
    });
  }
</script>