---
import { CONTACT, SITE } from "../config";
import Icon from "./Icon.astro";
---

<section
  class="min-h-[calc(100vh-4rem)] flex items-center py-20"
  aria-label="Apresentação"
>
  <div class="container">
    <div class="max-w-3xl">
      <!-- Location indicator -->
      <p
        class="font-mono text-sm text-[var(--text-muted)] mb-6 flex items-center gap-2"
      >
        <Icon name="map-pin" size={14} class="text-[var(--text-muted)]" />
        {SITE.location}
      </p>

      <!-- Headline -->
      <h1
        data-animate="hero-title"
        class="text-[clamp(2rem,5vw,3.25rem)] font-bold text-[var(--text)] leading-[1.1] tracking-tight mb-5 text-balance"
      >
        Desenvolvedor Full-Stack em busca de oportunidade
        <span class="text-[var(--text-muted)] font-semibold"
          >Júnior ou Estágio</span
        >
      </h1>

      <!-- Subheadline -->
      <p
        data-animate="hero-sub"
        class="text-base md:text-lg text-[var(--text-muted)] leading-relaxed mb-4 max-w-xl"
      >
        Back-end, banco de dados, IA, segurança, full-stack ou front-end.
        Disponível para CLT, freelance e startups.
      </p>

      <!-- Bio -->
      <p data-animate="hero-bio" class="text-sm text-[var(--text-muted)] leading-relaxed mb-10 max-w-lg">
        Tecnólogo em Desenvolvimento Back-End e Técnico em Desenvolvimento de
        Sistemas. Construo aplicações completas com foco em código limpo,
        segurança e utilidade real.
      </p>

      <!-- CTAs -->
      <div data-animate="hero-ctas" class="flex flex-wrap gap-3 mb-4">
        <a href="/#projetos" class="btn-primary">
          Ver projetos
          <Icon name="arrow-right" size={16} />
        </a>
        <a href={`mailto:${CONTACT.email}`} class="btn-outline">
          Entrar em contato
        </a>
        <button id="cv-preview-btn" class="btn-outline flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          Ver currículo
        </button>
      </div>

      <!-- Availability note -->
      <p data-animate="hero-avail" class="text-xs text-[var(--text-muted)]">
        Aberto a oportunidades CLT, estágio, freelance e projetos em startups.
      </p>
    </div>
  </div>
</section>

<!-- Modal currículo -->
<div
  id="cv-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Currículo — Davi Guimarães da Costa"
>
  <div class="relative bg-[var(--bg)] border border-[var(--border)] rounded-2xl w-full max-w-3xl max-h-[90vh] flex flex-col shadow-2xl">
    <!-- Header do modal -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border)] flex-shrink-0">
      <p class="text-sm font-medium text-[var(--text)]">Currículo — Davi Guimarães da Costa</p>
      <div class="flex items-center gap-3">
        <a
          href="/Curriculo_Davi_Guimaraes.pdf"
          download
          class="flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-full border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--text)] hover:border-[var(--text)] transition-colors"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Baixar PDF
        </a>
        <button
          id="cv-modal-close"
          class="text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
          aria-label="Fechar"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
    <!-- PDF -->
    <div class="flex-1 overflow-hidden p-2">
      <iframe
        id="cv-iframe"
        src=""
        class="w-full rounded-lg"
        style="height: 70vh;"
        title="Currículo Davi Guimarães da Costa"
      ></iframe>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  function init() {
    gsap.set('[data-animate^="hero"]', { opacity: 0, y: 30 });
    gsap.to('[data-animate="hero-title"]', { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", delay: 0.1 });
    gsap.to('[data-animate="hero-sub"]',   { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", delay: 0.3 });
    gsap.to('[data-animate="hero-bio"]',   { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", delay: 0.5 });
    gsap.to('[data-animate="hero-ctas"]',  { opacity: 1, y: 0, duration: 0.5, ease: "power3.out", delay: 0.7 });
    gsap.to('[data-animate="hero-avail"]', { opacity: 1, y: 0, duration: 0.5, ease: "power3.out", delay: 1.0 });
  }
  if (window._gsapReady) { init(); }
  else { (window._gsapQueue = window._gsapQueue || []).push(init); }
})();
</script>

<script>
  const btn = document.getElementById("cv-preview-btn")!;
  const modal = document.getElementById("cv-modal")!;
  const close = document.getElementById("cv-modal-close")!;
  const iframe = document.getElementById("cv-iframe") as HTMLIFrameElement;

  btn.addEventListener("click", () => {
    iframe.src = "/Curriculo_Davi_Guimaraes.pdf";
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  });

  function closeModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    iframe.src = "";
    document.body.style.overflow = "";
  }

  close.addEventListener("click", closeModal);
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>