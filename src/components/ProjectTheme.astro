---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{/* ============ POKÉDEX — 45 pokémons ============ */}
{slug === "pokedex" && (
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true" id="pokemon-bg"></div>
)}
{slug === "pokedex" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var container = document.getElementById("pokemon-bg");
    if (!container) return;

    var ids = [
      1,2,3,4,5,6,7,8,9,25,26,39,52,53,54,63,79,92,93,94,
      129,130,131,143,147,148,149,23,74,43,58,59,66,67,68,
      19,20,27,28,35,36,37,38,50,51
    ];

    var positions = [];
    for (var row = 0; row < 5; row++) {
      for (var col = 0; col < 9; col++) {
        positions.push([
          5 + row * 22 + Math.random() * 8,
          2 + col * 11 + Math.random() * 4
        ]);
      }
    }

    ids.forEach(function (id, i) {
      if (i >= positions.length) return;
      var img = document.createElement("img");
      img.src = "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/" + id + ".png";
      img.alt = "";
      img.width = 88;
      img.height = 88;
      img.style.cssText = [
        "position:absolute",
        "top:" + positions[i][0] + "%",
        "left:" + positions[i][1] + "%",
        "opacity:0.55",
        "image-rendering:pixelated",
        "filter:drop-shadow(0 0 6px rgba(0,0,0,0.15))"
      ].join(";");
      container.appendChild(img);

      img.onload = function () {
        if (typeof gsap === "undefined") return;
        gsap.to(img, {
          y: gsap.utils.random(-45, 45),
          x: gsap.utils.random(-22, 22),
          rotation: gsap.utils.random(-15, 15),
          duration: gsap.utils.random(3, 8),
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: Math.random() * 2
        });
      };
    });
  })();
  </script>
)}

{/* ============ DEAD DROP ============ */}
{slug === "dead-drop" && (
  <canvas id="matrix-canvas" class="fixed inset-0 pointer-events-none z-0" style="width:100%;height:100%;" aria-hidden="true"></canvas>
)}
{slug === "dead-drop" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var canvas = document.getElementById("matrix-canvas");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    var cols = Math.floor(canvas.width / 20);
    var drops = Array(cols).fill(1);
    var chars = "アイウエオカキクケコ01BCDEF$#@!%&*<>{}[]".split("");
    function isDark() { return document.documentElement.classList.contains("dark"); }
    function draw() {
      ctx.fillStyle = isDark() ? "rgba(10,10,10,0.04)" : "rgba(255,255,255,0.04)";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = "rgba(127,29,29,0.55)";
      ctx.font = "12px monospace";
      drops.forEach(function (y, i) {
        var char = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(char, i * 20, y * 20);
        if (y * 20 > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      });
    }
    setInterval(draw, 80);
    window.addEventListener("resize", function () {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    });
  })();
  </script>
)}

