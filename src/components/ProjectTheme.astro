---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{/* ============ POKÉDEX ============ */}
{slug === "pokedex" && (
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true" id="pokemon-bg"></div>
)}
{slug === "pokedex" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var container = document.getElementById("pokemon-bg");
    if (!container) return;

    // 20 Pokémons espalhados pela tela
    var ids = [1,4,7,25,39,52,94,143,131,54,63,129,58,92,79,43,147,23,74,50];
    var positions = [
      [3,3],[3,50],[3,88],[15,20],[15,72],
      [28,8],[28,60],[28,92],[42,35],[42,80],
      [55,5],[55,48],[55,85],[68,18],[68,65],
      [78,30],[78,78],[88,10],[88,52],[88,88]
    ];

    ids.forEach(function (id, i) {
      var img = document.createElement("img");
      img.src = "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/" + id + ".png";
      img.alt = "";
      img.width = 72;
      img.height = 72;
      img.style.cssText = [
        "position:absolute",
        "top:" + positions[i][0] + "%",
        "left:" + positions[i][1] + "%",
        "opacity:0.35",
        "image-rendering:pixelated",
        "transition:opacity 0.5s"
      ].join(";");
      container.appendChild(img);

      img.onload = function () {
        if (typeof gsap === "undefined") return;
        gsap.to(img, {
          y: gsap.utils.random(-35, 35),
          x: gsap.utils.random(-18, 18),
          rotation: gsap.utils.random(-12, 12),
          duration: gsap.utils.random(4, 10),
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1
        });
      };
    });
  })();
  </script>
)}

{/* ============ DEAD DROP ============ */}
{slug === "dead-drop" && (
  <canvas id="matrix-canvas" class="fixed inset-0 pointer-events-none z-0" style="width:100%;height:100%;" aria-hidden="true"></canvas>
)}
{slug === "dead-drop" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var canvas = document.getElementById("matrix-canvas");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    var cols = Math.floor(canvas.width / 20);
    var drops = Array(cols).fill(1);
    var chars = "アイウエオカキクケコ01BCDEF$#@!%&*<>{}[]".split("");

    function isDark() {
      return document.documentElement.classList.contains("dark");
    }

    function draw() {
      // Apaga com a cor de fundo correta para cada tema
      if (isDark()) {
        ctx.fillStyle = "rgba(10,10,10,0.04)";
      } else {
        ctx.fillStyle = "rgba(255,255,255,0.04)";
      }
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = "rgba(127,29,29,0.55)";
      ctx.font = "12px monospace";

      drops.forEach(function (y, i) {
        var char = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(char, i * 20, y * 20);
        if (y * 20 > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      });
    }

    setInterval(draw, 80);

    window.addEventListener("resize", function () {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    });
  })();
  </script>
)}

{/* ============ NEXUS CHAT ============ */}
{slug === "nexus-chat" && (
  <div id="chat-bg" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true"></div>
)}
{slug === "nexus-chat" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    function init() {
      if (typeof gsap === "undefined") { setTimeout(init, 100); return; }
      var container = document.getElementById("chat-bg");
      if (!container) return;

      var bubbles = [
        { w: 90,  h: 36, top: "8%",  left: "6%",  symbol: "···" },
        { w: 120, h: 36, top: "14%", left: "72%", symbol: "···" },
        { w: 70,  h: 36, top: "28%", left: "4%",  symbol: "···" },
        { w: 100, h: 36, top: "35%", left: "80%", symbol: "···" },
        { w: 80,  h: 36, top: "50%", left: "10%", symbol: "···" },
        { w: 110, h: 36, top: "58%", left: "70%", symbol: "···" },
        { w: 90,  h: 36, top: "72%", left: "5%",  symbol: "···" },
        { w: 75,  h: 36, top: "78%", left: "78%", symbol: "···" },
      ];

      bubbles.forEach(function (b, i) {
        var el = document.createElement("div");
        el.style.cssText = [
          "position:absolute",
          "top:" + b.top,
          "left:" + b.left,
          "width:" + b.w + "px",
          "height:" + b.h + "px",
          "border-radius:18px",
          "border:1px solid rgba(128,128,128,0.18)",
          "display:flex",
          "align-items:center",
          "justify-content:center",
          "font-size:15px",
          "color:rgba(128,128,128,0.18)",
          "font-family:monospace",
          "letter-spacing:5px"
        ].join(";");
        el.textContent = b.symbol;
        container.appendChild(el);

        gsap.to(el, {
          y: gsap.utils.random(-25, 25),
          x: gsap.utils.random(-12, 12),
          opacity: gsap.utils.random(0.4, 0.9),
          duration: gsap.utils.random(5, 11),
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: i * 0.35
        });
      });
    }

    init();
  })();
  </script>
)}

{/* ============ LEITOR XML ============ */}
{(slug === "leitor-xml" || slug === "fiscal-xml-reader") && (
  <div id="xml-bg" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true"></div>
)}
{(slug === "leitor-xml" || slug === "fiscal-xml-reader") && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    function init() {
      if (typeof gsap === "undefined") { setTimeout(init, 100); return; }
      var container = document.getElementById("xml-bg");
      if (!container) return;

      var tags = [
        "<nfeProc>", "<infNFe>", "<emit>", "<dest>",
        "<ICMSTot>", "<det>", "</nfeProc>", "<transp>",
        "<cobr>", "</infNFe>", "<ide>", "<total>",
        "<vNF>", "<CNPJ>", "<xNome>"
      ];
      var positions = [
        [6,4],[12,68],[22,14],[32,78],[44,6],[52,62],
        [63,18],[70,76],[80,8],[86,58],[18,42],[58,38],
        [36,25],[74,45],[90,72]
      ];

      tags.forEach(function (tag, i) {
        var el = document.createElement("span");
        el.style.cssText = [
          "position:absolute",
          "top:" + positions[i][0] + "%",
          "left:" + positions[i][1] + "%",
          "font-family:monospace",
          "font-size:11px",
          "color:rgba(128,128,128,0.12)",
          "white-space:nowrap",
          "opacity:0.12"
        ].join(";");
        el.textContent = "";
        container.appendChild(el);

        var delay = i * 0.7;

        function animateTag() {
          var current = 0;
          var interval = setInterval(function () {
            el.textContent = tag.substring(0, current);
            current++;
            if (current > tag.length) {
              clearInterval(interval);
              setTimeout(function () {
                gsap.to(el, {
                  opacity: 0, duration: 0.8,
                  onComplete: function () {
                    el.textContent = "";
                    el.style.opacity = "0.12";
                    setTimeout(animateTag, gsap.utils.random(1000, 3000));
                  }
                });
              }, 1800);
            }
          }, 80);
        }

        setTimeout(animateTag, delay * 1000);
      });
    }

    init();
  })();
  </script>
)}

{/* ============ PRYA ============ */}
{slug === "prya" && (
  <div
    id="terminal-bg"
    class="fixed bottom-8 left-8 pointer-events-none z-0"
    aria-hidden="true"
    style="font-family:monospace;font-size:11px;color:rgba(128,128,128,0.15);line-height:1.7;max-width:300px;"
  ></div>
)}
{slug === "prya" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    function init() {
      if (typeof gsap === "undefined") { setTimeout(init, 100); return; }
      var container = document.getElementById("terminal-bg");
      if (!container) return;

      var lines = [
        "$ python prya.py",
        "> Loading model...",
        "> deepseek-coder-v2 ready",
        "> Session started",
        ">>> analyze(code)",
        "  scanning tokens...",
        "  complexity: O(n log n)",
        "  issues found: 0",
        ">>> generate_function()",
        "  streaming response...",
        "  def process(data):",
        "    return result",
        "> Memory: 20 msgs",
        "> Context preserved",
        "$ _"
      ];

      var i = 0;
      function addLine() {
        if (i >= lines.length) {
          setTimeout(function () {
            container.innerHTML = "";
            i = 0;
            addLine();
          }, 3000);
          return;
        }
        var line = document.createElement("div");
        line.textContent = lines[i];
        line.style.opacity = "0";
        container.appendChild(line);
        gsap.to(line, { opacity: 1, duration: 0.3 });
        i++;
        setTimeout(addLine, 380);
      }

      setTimeout(addLine, 500);
    }

    init();
  })();
  </script>
)}

{/* ============ DTR ============ */}
{slug === "dtr" && (
  <canvas id="dtr-canvas" class="fixed inset-0 pointer-events-none z-0" style="width:100%;height:100%;" aria-hidden="true"></canvas>
)}
{slug === "dtr" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var canvas = document.getElementById("dtr-canvas");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    var cx = canvas.width / 2;
    var cy = canvas.height / 2;
    var radius = 90;
    var angle = 0;

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      var laX = cx + Math.cos(angle) * radius;
      var laY = cy + Math.sin(angle) * radius;
      var raX = cx + Math.cos(angle + Math.PI) * radius;
      var raY = cy + Math.sin(angle + Math.PI) * radius;

      // Linha de conexão pulsante
      var pulse = (Math.sin(angle * 3) + 1) / 2;
      ctx.strokeStyle = "rgba(128,128,128," + (0.05 + pulse * 0.06) + ")";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(laX, laY);
      ctx.lineTo(raX, raY);
      ctx.stroke();

      // Nó La
      ctx.beginPath();
      ctx.arc(laX, laY, 6, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(128,128,128,0.12)";
      ctx.fill();
      ctx.fillStyle = "rgba(128,128,128,0.10)";
      ctx.font = "10px monospace";
      ctx.fillText("La", laX + 10, laY + 4);

      // Nó Ra
      ctx.beginPath();
      ctx.arc(raX, raY, 6, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(128,128,128,0.10)";
      ctx.fill();
      ctx.fillStyle = "rgba(128,128,128,0.08)";
      ctx.fillText("Ra", raX + 10, raY + 4);

      angle += 0.006;
      requestAnimationFrame(draw);
    }

    draw();

    window.addEventListener("resize", function () {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      cx = canvas.width / 2;
      cy = canvas.height / 2;
    });
  })();
  </script>
)}

{/* ============ HOLLOW REIGN ============ */}
{slug === "hollow-reign" && (
  <canvas id="hollow-canvas" class="fixed inset-0 pointer-events-none z-0" style="width:100%;height:100%;" aria-hidden="true"></canvas>
)}
{slug === "hollow-reign" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var canvas = document.getElementById("hollow-canvas");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    function drawSword(x, y, size, alpha) {
      ctx.fillStyle = "rgba(128,128,128," + alpha + ")";
      var s = size;
      ctx.fillRect(x + s * 3, y,          s,     s * 5);
      ctx.fillRect(x,          y + s * 2, s * 7, s);
      ctx.fillRect(x + s * 3, y + s * 5,  s,     s * 2);
    }

    var particles = Array.from({ length: 35 }, function () {
      return {
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        speed: Math.random() * 0.5 + 0.15,
        size: Math.random() > 0.5 ? 2 : 3,
        alpha: Math.random() * 0.06 + 0.03,
        drift: (Math.random() - 0.5) * 0.25
      };
    });

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(function (p) {
        drawSword(p.x, p.y, p.size, p.alpha);
        p.y += p.speed;
        p.x += p.drift;
        if (p.y > canvas.height + 20) {
          p.y = -20;
          p.x = Math.random() * canvas.width;
        }
      });
      requestAnimationFrame(draw);
    }

    draw();

    window.addEventListener("resize", function () {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    });
  })();
  </script>
)}