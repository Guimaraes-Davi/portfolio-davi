---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{slug === "pokedex" && (
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true" id="pokemon-bg"></div>
)}
{slug === "pokedex" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var container = document.getElementById("pokemon-bg");
    if (!container) return;
    var ids = [1, 4, 7, 25, 39, 52, 94, 143];
    var positions = [
      [10, 10], [10, 85], [35, 5], [35, 88],
      [60, 10], [60, 82], [83, 18], [83, 73]
    ];
    ids.forEach(function (id, i) {
      var img = document.createElement("img");
      img.src = "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/" + id + ".png";
      img.alt = "";
      img.width = 64;
      img.height = 64;
      img.style.cssText = "position:absolute;top:" + positions[i][0] + "%;left:" + positions[i][1] + "%;opacity:0.15;image-rendering:pixelated;";
      container.appendChild(img);
      img.onload = function () {
        if (typeof gsap === "undefined") return;
        gsap.to(img, {
          y: gsap.utils.random(-30, 30),
          x: gsap.utils.random(-15, 15),
          rotation: gsap.utils.random(-8, 8),
          duration: gsap.utils.random(4, 9),
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1
        });
      };
    });
  })();
  </script>
)}

{slug === "dead-drop" && (
  <canvas id="matrix-canvas" class="fixed inset-0 pointer-events-none z-0" style="width:100%;height:100%;" aria-hidden="true"></canvas>
)}
{slug === "dead-drop" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var canvas = document.getElementById("matrix-canvas");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    var cols = Math.floor(canvas.width / 20);
    var drops = Array(cols).fill(1);
    var chars = "アイウエオカキクケコ01アBCDEF$#@!%&*<>{}[]".split("");
    function draw() {
      ctx.fillStyle = "rgba(0,0,0,0.03)";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = "rgba(127,29,29,0.5)";
      ctx.font = "12px monospace";
      drops.forEach(function (y, i) {
        var char = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(char, i * 20, y * 20);
        if (y * 20 > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      });
    }
    setInterval(draw, 80);
    window.addEventListener("resize", function () {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    });
  })();
  </script>
)}

{slug === "nexus-chat" && (
  <div id="chat-bg" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true"></div>
)}
{slug === "nexus-chat" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    function init() {
      if (typeof gsap === "undefined") return;
      var container = document.getElementById("chat-bg");
      if (!container) return;
      var bubbles = [
        { w: 90,  h: 36, top: "12%", left: "8%",  symbol: "..." },
        { w: 120, h: 36, top: "18%", left: "75%", symbol: "..." },
        { w: 70,  h: 36, top: "38%", left: "5%",  symbol: "..." },
        { w: 100, h: 36, top: "42%", left: "82%", symbol: "..." },
        { w: 80,  h: 36, top: "65%", left: "12%", symbol: "..." },
        { w: 110, h: 36, top: "70%", left: "72%", symbol: "..." }
      ];
      bubbles.forEach(function (b, i) {
        var el = document.createElement("div");
        el.style.cssText = [
          "position:absolute",
          "top:" + b.top,
          "left:" + b.left,
          "width:" + b.w + "px",
          "height:" + b.h + "px",
          "border-radius:18px",
          "border:1px solid rgba(128,128,128,0.12)",
          "display:flex",
          "align-items:center",
          "justify-content:center",
          "font-size:14px",
          "color:rgba(128,128,128,0.12)",
          "font-family:monospace",
          "letter-spacing:4px",
          "opacity:0.6"
        ].join(";");
        el.textContent = b.symbol;
        container.appendChild(el);
        gsap.to(el, {
          y: gsap.utils.random(-20, 20),
          x: gsap.utils.random(-10, 10),
          opacity: gsap.utils.random(0.3, 0.7),
          duration: gsap.utils.random(5, 10),
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: i * 0.4
        });
      });
    }
    if (window._gsapReady) { init(); }
    else { (window._gsapQueue = window._gsapQueue || []).push(init); }
  })();
  </script>
)}

{slug === "leitor-xml" && (
  <div id="xml-bg" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true"></div>
)}
{slug === "leitor-xml" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    function init() {
      if (typeof gsap === "undefined") return;
      var container = document.getElementById("xml-bg");
      if (!container) return;
      var tags = [
        "<nfeProc>", "<infNFe>", "<emit>", "<dest>",
        "<ICMSTot>", "<det>", "</nfeProc>", "<transp>",
        "<cobr>", "</infNFe>", "<ide>", "<total>"
      ];
      var positions = [
        [8,5],[15,70],[28,15],[35,80],[48,8],[55,65],
        [68,20],[72,78],[82,10],[88,60],[22,45],[62,40]
      ];
      tags.forEach(function (tag, i) {
        var el = document.createElement("span");
        el.style.cssText = [
          "position:absolute",
          "top:" + positions[i][0] + "%",
          "left:" + positions[i][1] + "%",
          "font-family:monospace",
          "font-size:11px",
          "color:rgba(128,128,128,0.07)",
          "white-space:nowrap"
        ].join(";");
        el.textContent = "";
        container.appendChild(el);
        var delay = i * 0.8;
        var tl = gsap.timeline({ repeat: -1, delay: delay });
        tl.to(el, {
          duration: tag.length * 0.08,
          ease: "none",
          onUpdate: function () {
            var progress = Math.floor(tl.progress() * tag.length * 2);
            if (progress <= tag.length) {
              el.textContent = tag.substring(0, progress);
            }
          }
        })
        .to(el, { opacity: 0, duration: 1, delay: 1.5 })
        .set(el, { opacity: 0.07, textContent: "" });
      });
    }
    if (window._gsapReady) { init(); }
    else { (window._gsapQueue = window._gsapQueue || []).push(init); }
  })();
  </script>
)}

{slug === "prya" && (
  <div
    id="terminal-bg"
    class="fixed bottom-8 left-8 pointer-events-none z-0"
    aria-hidden="true"
    style="font-family:monospace;font-size:11px;color:rgba(128,128,128,0.1);line-height:1.6;max-width:280px;"
  ></div>
)}
{slug === "prya" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    function init() {
      if (typeof gsap === "undefined") return;
      var container = document.getElementById("terminal-bg");
      if (!container) return;
      var lines = [
        "$ python prya.py",
        "> Loading model...",
        "> deepseek-coder-v2 ready",
        "> Session started",
        ">>> analyze(code)",
        "  scanning tokens...",
        "  complexity: O(n log n)",
        "  issues found: 0",
        ">>> generate_function()",
        "  streaming response...",
        "  def process(data):",
        "    return result",
        "> Memory: 20 msgs",
        "> Context preserved",
        "$ _"
      ];
      var i = 0;
      function addLine() {
        if (i >= lines.length) {
          setTimeout(function () {
            container.innerHTML = "";
            i = 0;
            addLine();
          }, 3000);
          return;
        }
        var line = document.createElement("div");
        line.textContent = lines[i];
        line.style.opacity = "0";
        container.appendChild(line);
        gsap.to(line, { opacity: 1, duration: 0.3 });
        i++;
        setTimeout(addLine, 400);
      }
      setTimeout(addLine, 500);
    }
    if (window._gsapReady) { init(); }
    else { (window._gsapQueue = window._gsapQueue || []).push(init); }
  })();
  </script>
)}

{slug === "dtr" && (
  <canvas id="dtr-canvas" class="fixed inset-0 pointer-events-none z-0" style="width:100%;height:100%;" aria-hidden="true"></canvas>
)}
{slug === "dtr" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var canvas = document.getElementById("dtr-canvas");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    var cx = canvas.width / 2;
    var cy = canvas.height / 2;
    var radius = 80;
    var angle = 0;
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      var laX = cx + Math.cos(angle) * radius;
      var laY = cy + Math.sin(angle) * radius;
      var raX = cx + Math.cos(angle + Math.PI) * radius;
      var raY = cy + Math.sin(angle + Math.PI) * radius;
      var pulse = (Math.sin(angle * 3) + 1) / 2;
      ctx.strokeStyle = "rgba(128,128,128," + (0.03 + pulse * 0.04) + ")";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(laX, laY);
      ctx.lineTo(raX, raY);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(laX, laY, 5, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(128,128,128,0.08)";
      ctx.fill();
      ctx.fillStyle = "rgba(128,128,128,0.06)";
      ctx.font = "10px monospace";
      ctx.fillText("La", laX + 8, laY + 4);
      ctx.beginPath();
      ctx.arc(raX, raY, 5, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(128,128,128,0.06)";
      ctx.fill();
      ctx.fillStyle = "rgba(128,128,128,0.05)";
      ctx.fillText("Ra", raX + 8, raY + 4);
      angle += 0.005;
      requestAnimationFrame(draw);
    }
    draw();
    window.addEventListener("resize", function () {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      cx = canvas.width / 2;
      cy = canvas.height / 2;
    });
  })();
  </script>
)}

{slug === "hollow-reign" && (
  <canvas id="hollow-canvas" class="fixed inset-0 pointer-events-none z-0" style="width:100%;height:100%;" aria-hidden="true"></canvas>
)}
{slug === "hollow-reign" && (
  <script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var canvas = document.getElementById("hollow-canvas");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    function drawSword(x, y, size, alpha) {
      ctx.fillStyle = "rgba(128,128,128," + alpha + ")";
      var s = size;
      ctx.fillRect(x + s * 3, y,           s,     s * 5);
      ctx.fillRect(x,          y + s * 2,  s * 7, s);
      ctx.fillRect(x + s * 3, y + s * 5,  s,     s * 2);
    }
    var particles = Array.from({ length: 25 }, function () {
      return {
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        speed: Math.random() * 0.4 + 0.1,
        size: Math.random() > 0.5 ? 2 : 3,
        alpha: Math.random() * 0.04 + 0.02,
        drift: (Math.random() - 0.5) * 0.2
      };
    });
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(function (p) {
        drawSword(p.x, p.y, p.size, p.alpha);
        p.y += p.speed;
        p.x += p.drift;
        if (p.y > canvas.height + 20) {
          p.y = -20;
          p.x = Math.random() * canvas.width;
        }
      });
      requestAnimationFrame(draw);
    }
    draw();
    window.addEventListener("resize", function () {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    });
  })();
  </script>
)}
