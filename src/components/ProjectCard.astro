---
import StatusBadge from "./StatusBadge.astro";
import TechChip from "./TechChip.astro";
import Icon from "./Icon.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, shortDescription, status, stack, githubUrl, liveUrl, privateProject } =
  project.data;
const href = `/projetos/${project.slug}`;

// Show max 3 stack items on card footer
const visibleStack = stack.slice(0, 3);
const remaining = stack.length - visibleStack.length;
const hasGithub = githubUrl && !githubUrl.includes("{{");
const hasLive = liveUrl && !liveUrl.includes("{{");
---

<article
  class="group relative flex flex-col rounded-xl border border-[var(--border)] bg-[var(--bg)] p-5 hover:border-[var(--accent)] transition-colors duration-200"
>
  <!-- Top row: quick actions (left) + status badge (right) -->
  <div class="flex items-start justify-between gap-3 mb-4">
    <!-- Quick actions on hover -->
    <div
      class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity"
    >
      {
        hasGithub && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-1.5 rounded-md text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors"
            aria-label={`Ver ${title} no GitHub`}
            title="GitHub"
          >
            <Icon name="github" size={14} />
          </a>
        )
      }
      {
        hasLive && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-1.5 rounded-md text-[var(--text-muted)] hover:text-[var(--text)] hover:bg-[var(--bg-subtle)] transition-colors"
            aria-label={`Abrir ${title} ao vivo`}
            title="Ver ao vivo"
          >
            <Icon name="external-link" size={14} />
          </a>
        )
      }
    </div>

    <!-- Status badge — top right -->
    <div class="flex items-center gap-2">
      {
        privateProject && (
          <span
            class="inline-flex items-center gap-1 text-xs text-[var(--text-muted)]"
            title="Projeto privado"
          >
            <Icon name="lock" size={11} />
          </span>
        )
      }
      <StatusBadge status={status} />
    </div>
  </div>

  <!-- Title + description -->
  <a href={href} class="flex-1 group/link mb-4">
    <h3
      class="text-sm font-semibold text-[var(--text)] mb-2 group-hover/link:underline underline-offset-2"
    >
      {title}
    </h3>
    <p class="text-xs text-[var(--text-muted)] leading-relaxed line-clamp-3">
      {shortDescription}
    </p>
  </a>

  <!-- Footer: stack chips + view link -->
  <div class="mt-auto">
    <div
      class="flex flex-wrap gap-1.5 mb-3"
      aria-label="Tecnologias usadas"
    >
      {visibleStack.map((tech) => <TechChip tech={tech} />)}
      {
        remaining > 0 && (
          <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-mono text-[var(--text-muted)] border border-[var(--border)] bg-[var(--bg-subtle)]">
            +{remaining}
          </span>
        )
      }
    </div>

    <div class="pt-3 border-t border-[var(--border)]">
      <a
        href={href}
        class="text-xs text-[var(--text-muted)] hover:text-[var(--text)] transition-colors flex items-center gap-1"
        aria-label={`Ver detalhes de ${title}`}
        tabindex="-1"
        aria-hidden="true"
      >
        Ver detalhes
        <Icon name="arrow-right" size={11} />
      </a>
    </div>
  </div>
</article>
